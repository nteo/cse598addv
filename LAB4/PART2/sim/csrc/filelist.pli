PLI_STUB_OBJS_OBJ1=_vcs_pli_stub_.o
PLI_STUB_OBJS_SRC1=_vcs_pli_stub_.c
PLI_STUB_OBJS += $(PLI_STUB_OBJS_OBJ1)
$(PLI_STUB_OBJS_OBJ1): $(PLI_STUB_OBJS_SRC1)
	@$(CC) -I/usr/local2/synopsys/vcs_2024/vcs/W-2024.09-SP2-3/include  -pipe -fPIC -I/usr/local2/synopsys/vcs_2024/vcs/W-2024.09-SP2-3/include     -fno-strict-aliasing -fno-optimize-sibling-calls  -fPIC -c -o $(PLI_STUB_OBJS_OBJ1) $(PLI_STUB_OBJS_SRC1)
	@strip -g $(PLI_STUB_OBJS_OBJ1)
